{
  "name": "sky-stack",
  "version": "1.0.0",
  "description": "Sky Stack - tap-timing tower stacking game for CrazyGames",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --outfile=dist/bundle.js && node scripts/pack.mjs",
    "dev": "esbuild src/main.js --bundle --outfile=dist/bundle.js --watch --servedir=dist"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright": "^1.62.1"
  }
}
